/* ===================== SIDEBAR ===================== */
var NOTES_KEY = 'buku-kas-harian:notes:v1';
var notes = [];
var editingId = null;

function loadNotes(){
  try{
    var raw = window.localStorage.getItem(NOTES_KEY);
    notes = raw ? JSON.parse(raw) : [];
    if (!Array.isArray(notes)) notes = [];
  }catch(e){ notes = []; }
}
function saveNotes(){
  try{ window.localStorage.setItem(NOTES_KEY, JSON.stringify(notes)); }catch(e){}
}

function openSidebar(){
  document.getElementById('sidebar').classList.add('open');
  document.getElementById('sidebar').setAttribute('aria-hidden','false');
  document.getElementById('scrim').classList.add('open');
  document.getElementById('menuBtn').setAttribute('aria-expanded','true');
  document.body.classList.add('sb-open');
}
function closeSidebar(){
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sidebar').setAttribute('aria-hidden','true');
  document.getElementById('scrim').classList.remove('open');
  document.getElementById('menuBtn').setAttribute('aria-expanded','false');
  document.body.classList.remove('sb-open');
}
function switchTab(targetId){
  ['panelCalc','panelNotes'].forEach(function(id){
    document.getElementById(id).classList.toggle('active', id === targetId);
  });
  document.getElementById('tabCalc').classList.toggle('active', targetId === 'panelCalc');
  document.getElementById('tabNotes').classList.toggle('active', targetId === 'panelNotes');
}

/* ---------- Kalkulator ---------- */
var cExpr = '';
var cJustEval = false;
var OPS = ['+','\u2212','\u00d7','\u00f7'];
function isOp(ch){ return OPS.indexOf(ch) !== -1; }

// Parser aman (tanpa eval): + - * / dan % (persen)
function evaluate(str){
  var src = str.replace(/\u2212/g,'-').replace(/\u00d7/g,'*').replace(/\u00f7/g,'/');
  var i = 0;
  function peek(){ return src.charAt(i); }
  function num(){
    var st = i;
    while (/[0-9.]/.test(peek())) i++;
    if (st === i) throw new Error('bad');
    var v = parseFloat(src.slice(st,i));
    if (isNaN(v)) throw new Error('bad');
    while (peek() === '%'){ v = v / 100; i++; }
    return v;
  }
  function unary(){
    if (peek() === '-'){ i++; return -unary(); }
    return num();
  }
  function term(){
    var v = unary();
    while (peek() === '*' || peek() === '/'){
      var o = peek(); i++;
      var r = unary();
      if (o === '*') v *= r;
      else { if (r === 0) throw new Error('div0'); v /= r; }
    }
    return v;
  }
  function expr(){
    var v = term();
    while (peek() === '+' || peek() === '-'){
      var o = peek(); i++;
      var r = term();
      v = (o === '+') ? v + r : v - r;
    }
    return v;
  }
  var out = expr();
  if (i !== src.length) throw new Error('bad');
  return Math.round(out * 1e10) / 1e10;
}

function fmtNum(n){ return n.toLocaleString('id-ID', {maximumFractionDigits:10}); }
function fmtExpr(e){ return e.replace(/\./g, ','); }

function safeEval(str){
  var s = str;
  while (s && isOp(s.charAt(s.length-1))) s = s.slice(0,-1);
  if (!s) return null;
  try{ return evaluate(s); }catch(e){ return undefined; }
}

function renderCalc(){
  var exprEl = document.getElementById('calcExpr');
  var resEl = document.getElementById('calcResult');
  exprEl.textContent = fmtExpr(cExpr);
  if (!cExpr){ resEl.textContent = '0'; return; }
  var v = safeEval(cExpr);
  if (v === null) resEl.textContent = '0';
  else if (v === undefined) resEl.textContent = cJustEval ? 'Error' : resEl.textContent;
  else resEl.textContent = fmtNum(v);
}

function calcPress(k){
  document.getElementById('calcMsg').textContent = '';
  var last = cExpr.charAt(cExpr.length-1);

  if (k === 'C'){ cExpr = ''; cJustEval = false; renderCalc(); return; }
  if (k === '\u232b'){
    cExpr = cJustEval ? '' : cExpr.slice(0,-1);
    cJustEval = false; renderCalc(); return;
  }
  if (k === '='){
    if (!cExpr) return;
    var v = safeEval(cExpr);
    if (v === null) return;
    if (v === undefined){
      document.getElementById('calcResult').textContent = 'Error';
      cExpr = ''; cJustEval = false;
      document.getElementById('calcExpr').textContent = '';
      return;
    }
    cExpr = String(v);
    cJustEval = true;
    document.getElementById('calcExpr').textContent = '';
    document.getElementById('calcResult').textContent = fmtNum(v);
    return;
  }
  if (/[0-9]/.test(k)){
    if (cJustEval){ cExpr = ''; cJustEval = false; }
    var m = cExpr.match(/[0-9.]+$/);
    if (m && m[0] === '0' && k === '0') return;
    if (m && m[0] === '0' && k !== '0') cExpr = cExpr.slice(0,-1);
    if (last === '%') return;
    cExpr += k; renderCalc(); return;
  }
  if (k === '.'){
    if (cJustEval){ cExpr = ''; cJustEval = false; }
    var seg = cExpr.match(/[0-9.]*$/)[0];
    if (seg.indexOf('.') !== -1 || last === '%') return;
    cExpr += (seg === '' ? '0.' : '.'); renderCalc(); return;
  }
  if (k === '%'){
    if (!cExpr || isOp(last) || last === '%') return;
    cJustEval = false;
    cExpr += '%'; renderCalc(); return;
  }
  if (isOp(k)){
    cJustEval = false;
    if (!cExpr){ if (k === '\u2212') cExpr = '\u2212'; renderCalc(); return; }
    if (cExpr === '\u2212') return;
    if (isOp(last)) cExpr = cExpr.slice(0,-1);
    cExpr += k; renderCalc(); return;
  }
}

function buildCalcKeys(){
  var layout = [
    ['C','fn'],['\u232b','fn'],['%','fn'],['\u00f7','op'],
    ['7'],['8'],['9'],['\u00d7','op'],
    ['4'],['5'],['6'],['\u2212','op'],
    ['1'],['2'],['3'],['+','op'],
    ['0'],['.'],['00'],['=','eq']
  ];
  var grid = document.getElementById('calcKeys');
  layout.forEach(function(item){
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'key' + (item[1] ? ' ' + item[1] : '');
    b.textContent = item[0];
    if (item[0] === '\u232b') b.setAttribute('aria-label','Hapus satu karakter');
    b.addEventListener('click', function(){
      if (item[0] === '00'){ calcPress('0'); calcPress('0'); }
      else calcPress(item[0]);
    });
    grid.appendChild(b);
  });
}

// Kirim hasil kalkulator ke kolom nominal di halaman utama
function useCalcResult(){
  var msg = document.getElementById('calcMsg');
  var v = cExpr ? safeEval(cExpr) : null;
  if (v === null || v === undefined || !isFinite(v) || v <= 0){
    msg.textContent = 'Hitung dulu sampai hasilnya lebih dari 0.';
    return;
  }
  var amt = Math.round(v);
  if (amt <= 0){ msg.textContent = 'Hasil terlalu kecil untuk dijadikan nominal.'; return; }
  var input = document.getElementById('customAmount');
  input.value = String(amt);
  showMsg('');
  closeSidebar();
  input.scrollIntoView({behavior:'smooth', block:'center'});
}

/* ---------- Catatan ---------- */
function resetNoteForm(){
  editingId = null;
  document.getElementById('noteText').value = '';
  document.getElementById('noteSave').textContent = 'Simpan catatan';
  document.getElementById('noteCancel').classList.remove('show');
}

function saveNote(){
  var ta = document.getElementById('noteText');
  var text = ta.value.trim();
  if (!text) return;
  if (editingId){
    notes.forEach(function(n){ if (n.id === editingId) n.text = text; });
  } else {
    var now = new Date();
    notes.unshift({
      id: now.getTime() + '-' + Math.random().toString(36).slice(2,7),
      text: text,
      timeDisplay: now.toLocaleString('id-ID',
        {day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'})
    });
  }
  saveNotes();
  resetNoteForm();
  renderNotes();
}

function renderNotes(){
  var list = document.getElementById('notesList');
  list.innerHTML = '';
  if (notes.length === 0){
    var empty = document.createElement('div');
    empty.className = 'empty';
    empty.textContent = 'Belum ada catatan.';
    list.appendChild(empty);
    return;
  }
  notes.forEach(function(n){
    var item = document.createElement('div');
    item.className = 'nitem';

    var body = document.createElement('div');
    body.className = 'nbody';
    body.title = 'Ketuk untuk mengedit';
    var t = document.createElement('div');
    t.className = 'ntext';
    t.textContent = n.text;
    var tm = document.createElement('div');
    tm.className = 'ntime';
    tm.textContent = n.timeDisplay || '';
    body.appendChild(t);
    body.appendChild(tm);
    body.addEventListener('click', function(){
      editingId = n.id;
      var ta = document.getElementById('noteText');
      ta.value = n.text;
      ta.focus();
      document.getElementById('noteSave').textContent = 'Perbarui catatan';
      document.getElementById('noteCancel').classList.add('show');
    });

    var del = document.createElement('button');
    del.className = 'ndel';
    del.type = 'button';
    del.setAttribute('aria-label','Hapus catatan');
    del.textContent = '\u00d7';
    del.addEventListener('click', function(){
      notes = notes.filter(function(x){ return x.id !== n.id; });
      if (editingId === n.id) resetNoteForm();
      saveNotes();
      renderNotes();
    });

    item.appendChild(body);
    item.appendChild(del);
    list.appendChild(item);
  });
}

function initSidebar(){
  document.getElementById('menuBtn').addEventListener('click', openSidebar);
  document.getElementById('sbClose').addEventListener('click', closeSidebar);
  document.getElementById('scrim').addEventListener('click', closeSidebar);
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeSidebar(); });

  document.getElementById('tabCalc').addEventListener('click', function(){ switchTab('panelCalc'); });
  document.getElementById('tabNotes').addEventListener('click', function(){ switchTab('panelNotes'); });

  buildCalcKeys();
  renderCalc();
  document.getElementById('useResult').addEventListener('click', useCalcResult);

  loadNotes();
  renderNotes();
  document.getElementById('noteSave').addEventListener('click', saveNote);
  document.getElementById('noteCancel').addEventListener('click', resetNoteForm);
}
