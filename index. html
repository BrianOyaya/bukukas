<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Buku Kas Harian & Catatan</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* Styling khusus scrollbar dan modal */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .calc-btn { @apply bg-white hover:bg-gray-100 text-gray-800 font-semibold py-4 rounded-xl shadow-sm text-xl border border-gray-200 transition active:scale-95; }
    .calc-op { @apply bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-4 rounded-xl shadow-md text-xl transition active:scale-95; }
  </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <!-- TOP HEADER BAR -->
  <header class="bg-indigo-600 text-white shadow-md sticky top-0 z-30 flex items-center justify-between px-4 py-3">
    <div class="flex items-center gap-3">
      <!-- Button Garis Tiga (Sidebar Toggle) -->
      <button onclick="toggleSidebar()" class="p-2 rounded-lg hover:bg-indigo-700 focus:outline-none transition" aria-label="Buka Menu">
        <i class="fa-solid fa-bars text-xl"></i>
      </button>
      <h1 id="header-title" class="text-lg font-bold tracking-wide truncate">Buku Kas Harian</h1>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="openAddModal()" id="quick-add-btn" class="bg-indigo-500 hover:bg-indigo-700 text-white p-2 rounded-full shadow text-sm transition">
        <i class="fa-solid fa-plus w-4 h-4 flex items-center justify-center"></i>
      </button>
    </div>
  </header>

  <!-- OVERLAY BACKGROUND UNTUK SIDEBAR -->
  <div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/50 z-40 hidden transition-opacity duration-300 opacity-0"></div>

  <!-- SIDEBAR MENU (GARIS TIGA DI ATAS KIRI) -->
  <aside id="sidebar" class="fixed top-0 left-0 bottom-0 w-72 bg-white z-50 shadow-2xl transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
    <!-- Header Sidebar -->
    <div class="bg-indigo-600 text-white p-5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="bg-white text-indigo-600 p-2 rounded-xl shadow font-bold text-lg">
          <i class="fa-solid fa-wallet"></i>
        </div>
        <div>
          <h2 class="font-bold text-base leading-tight">Kas & Catatan</h2>
          <p class="text-xs text-indigo-200">Aplikasi Keuangan Harian</p>
        </div>
      </div>
      <button onclick="toggleSidebar()" class="text-indigo-200 hover:text-white p-1">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <!-- Navigasi Menu -->
    <nav class="p-4 space-y-1 flex-1 overflow-y-auto">
      <button onclick="switchView('kas')" class="nav-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left font-medium transition text-indigo-600 bg-indigo-50" id="nav-kas">
        <i class="fa-solid fa-book-bookmark text-lg w-6 text-center"></i>
        <span>Buku Kas Harian</span>
      </button>

      <button onclick="switchView('hutang')" class="nav-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left font-medium transition text-gray-600 hover:bg-gray-100" id="nav-hutang">
        <i class="fa-solid fa-hand-holding-dollar text-lg w-6 text-center"></i>
        <span>Hutang & Piutang</span>
      </button>

      <button onclick="switchView('kalkulator')" class="nav-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left font-medium transition text-gray-600 hover:bg-gray-100" id="nav-kalkulator">
        <i class="fa-solid fa-calculator text-lg w-6 text-center"></i>
        <span>Kalkulator</span>
      </button>

      <button onclick="switchView('catatan')" class="nav-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left font-medium transition text-gray-600 hover:bg-gray-100" id="nav-catatan">
        <i class="fa-solid fa-note-sticky text-lg w-6 text-center"></i>
        <span>Catatan Ringkas</span>
      </button>

      <hr class="my-3 border-gray-200">

      <button onclick="switchView('pengaturan')" class="nav-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left font-medium transition text-gray-600 hover:bg-gray-100" id="nav-pengaturan">
        <i class="fa-solid fa-file-export text-lg w-6 text-center"></i>
        <span>Backup / Restore JSON</span>
      </button>
    </nav>

    <!-- Footer Sidebar -->
    <div class="p-4 border-t border-gray-100 text-xs text-gray-400 text-center">
      Versi 1.0.0 &bull; Siap untuk APK
    </div>
  </aside>

  <!-- KONTEN UTAMA APLIKASI -->
  <main class="flex-1 max-w-lg w-full mx-auto p-4 space-y-4">

    <!-- VIEW 1: BUKU KAS HARIAN -->
    <section id="view-kas" class="space-y-4">
      <!-- Ringkasan Saldo -->
      <div class="bg-gradient-to-br from-indigo-600 to-indigo-800 rounded-2xl p-5 text-white shadow-lg space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-indigo-200">Total Saldo Kas</span>
        <h2 id="total-saldo" class="text-3xl font-extrabold tracking-tight">Rp 0</h2>
        <div class="grid grid-cols-2 gap-3 pt-2 border-t border-indigo-500/40 text-sm">
          <div class="bg-indigo-700/50 p-2.5 rounded-xl">
            <span class="text-xs text-emerald-300 block font-medium">Pemasukan</span>
            <span id="total-pemasukan" class="font-bold text-emerald-400 text-base">Rp 0</span>
          </div>
          <div class="bg-indigo-700/50 p-2.5 rounded-xl">
            <span class="text-xs text-rose-300 block font-medium">Pengeluaran</span>
            <span id="total-pengeluaran" class="font-bold text-rose-300 text-base">Rp 0</span>
          </div>
        </div>
      </div>

      <!-- Tombol Aksi Tambah Transaksi -->
      <div class="grid grid-cols-2 gap-3">
        <button onclick="openAddModal('in')" class="flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-600 active:scale-95 text-white py-3 px-4 rounded-xl font-bold shadow-sm transition">
          <i class="fa-solid fa-arrow-down"></i> Kas Masuk
        </button>
        <button onclick="openAddModal('out')" class="flex items-center justify-center gap-2 bg-rose-500 hover:bg-rose-600 active:scale-95 text-white py-3 px-4 rounded-xl font-bold shadow-sm transition">
          <i class="fa-solid fa-arrow-up"></i> Kas Keluar
        </button>
      </div>

      <!-- Daftar Transaksi -->
      <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-gray-100">
          <h3 class="font-bold text-gray-700">Riwayat Transaksi</h3>
          <span id="entry-count" class="text-xs bg-gray-100 text-gray-600 font-medium px-2.5 py-1 rounded-full">0 Data</span>
        </div>
        <div id="kas-list" class="space-y-2.5 max-h-[420px] overflow-y-auto pr-1">
          <!-- Item transaksi akan dirender secara dinamis -->
        </div>
      </div>
    </section>

    <!-- VIEW 2: HUTANG & PIUTANG -->
    <section id="view-hutang" class="space-y-4 hidden">
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm">
          <span class="text-xs text-gray-500 font-medium">Total Piutang (Tagihan)</span>
          <p id="total-piutang" class="text-xl font-bold text-emerald-600 mt-1">Rp 0</p>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm">
          <span class="text-xs text-gray-500 font-medium">Total Hutang</span>
          <p id="total-hutang" class="text-xl font-bold text-rose-500 mt-1">Rp 0</p>
        </div>
      </div>

      <button onclick="openDebtModal()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl shadow-sm transition flex items-center justify-center gap-2">
        <i class="fa-solid fa-plus"></i> Catat Hutang / Piutang
      </button>

      <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 space-y-3">
        <h3 class="font-bold text-gray-700 pb-2 border-b border-gray-100">Daftar Catatan Hutang / Piutang</h3>
        <div id="debt-list" class="space-y-2.5">
          <!-- Item hutang dirender dinamis -->
        </div>
      </div>
    </section>

    <!-- VIEW 3: KALKULTOR -->
    <section id="view-kalkulator" class="space-y-4 hidden">
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
        <!-- Display Kalkulator -->
        <div class="bg-gray-900 text-white p-4 rounded-xl text-right mb-4">
          <div id="calc-expression" class="text-xs text-gray-400 min-h-[1rem] tracking-wider font-mono"></div>
          <div id="calc-display" class="text-3xl font-bold font-mono tracking-tight truncate">0</div>
        </div>

        <!-- Tombol Kalkulator -->
        <div class="grid grid-cols-4 gap-2">
          <button onclick="calcClear()" class="bg-rose-100 text-rose-600 font-bold py-4 rounded-xl hover:bg-rose-200">C</button>
          <button onclick="calcBackspace()" class="bg-gray-200 text-gray-700 font-bold py-4 rounded-xl hover:bg-gray-300"><i class="fa-solid fa-backspace"></i></button>
          <button onclick="calcAppend('/')" class="calc-op">&divide;</button>
          <button onclick="calcAppend('*')" class="calc-op">&times;</button>

          <button onclick="calcAppend('7')" class="calc-btn">7</button>
          <button onclick="calcAppend('8')" class="calc-btn">8</button>
          <button onclick="calcAppend('9')" class="calc-btn">9</button>
          <button onclick="calcAppend('-')" class="calc-op">&minus;</button>

          <button onclick="calcAppend('4')" class="calc-btn">4</button>
          <button onclick="calcAppend('5')" class="calc-btn">5</button>
          <button onclick="calcAppend('6')" class="calc-btn">6</button>
          <button onclick="calcAppend('+')" class="calc-op">+</button>

          <button onclick="calcAppend('1')" class="calc-btn">1</button>
          <button onclick="calcAppend('2')" class="calc-btn">2</button>
          <button onclick="calcAppend('3')" class="calc-btn">3</button>
          <button onclick="calcCalculate()" class="row-span-2 bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold py-4 rounded-xl shadow-lg text-2xl">=</button>

          <button onclick="calcAppend('0')" class="col-span-2 calc-btn">0</button>
          <button onclick="calcAppend('.')" class="calc-btn">.</button>
        </div>
      </div>
    </section>

    <!-- VIEW 4: CATATAN (NOTES) -->
    <section id="view-catatan" class="space-y-4 hidden">
      <button onclick="openNoteModal()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl shadow-sm transition flex items-center justify-center gap-2">
        <i class="fa-solid fa-pen-to-square"></i> Buat Catatan Baru
      </button>

      <div id="notes-list" class="space-y-3">
        <!-- List catatan dirender dinamis -->
      </div>
    </section>

    <!-- VIEW 5: PENGATURAN & BACKUP -->
    <section id="view-pengaturan" class="space-y-4 hidden">
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 space-y-4">
        <h3 class="font-bold text-gray-800 text-base">Kelola Data JSON</h3>
        <p class="text-xs text-gray-500 leading-relaxed">
          Ekspor seluruh data transaksi dan hutang ke berkas JSON untuk dicadangkan, atau impor data dari berkas JSON cadangan Anda.
        </p>

        <div class="space-y-3">
          <button onclick="exportDataJSON()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-4 rounded-xl shadow-sm transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-download"></i> Ekspor Data Ke JSON
          </button>

          <label class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-xl shadow-sm transition flex items-center justify-center gap-2 cursor-pointer text-center">
            <i class="fa-solid fa-upload"></i> Impor Data Dari JSON
            <input type="file" id="import-file" accept=".json" onchange="importDataJSON(event)" class="hidden">
          </label>
        </div>
      </div>
    </section>
  </main>

  <!-- MODAL TRANSAKSI KAS -->
  <div id="modal-add" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-xl overflow-hidden animate-fade-in">
      <div class="p-4 bg-indigo-600 text-white flex justify-between items-center">
        <h3 id="modal-title" class="font-bold">Tambah Transaksi</h3>
        <button onclick="closeModal('modal-add')" class="text-indigo-200 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>
      <form onsubmit="saveTransaction(event)" class="p-5 space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Tipe Transaksi</label>
          <div class="grid grid-cols-2 gap-2">
            <label class="flex items-center justify-center gap-2 p-2.5 border border-gray-200 rounded-xl cursor-pointer has-[:checked]:bg-emerald-50 has-[:checked]:border-emerald-500 font-semibold text-sm">
              <input type="radio" name="tx-type" value="in" id="tx-in" checked class="accent-emerald-600">
              <span class="text-emerald-700">Kas Masuk</span>
            </label>
            <label class="flex items-center justify-center gap-2 p-2.5 border border-gray-200 rounded-xl cursor-pointer has-[:checked]:bg-rose-50 has-[:checked]:border-rose-500 font-semibold text-sm">
              <input type="radio" name="tx-type" value="out" id="tx-out" class="accent-rose-600">
              <span class="text-rose-700">Kas Keluar</span>
            </label>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Nominal (Rp)</label>
          <input type="number" id="tx-amount" required min="1" placeholder="Contoh: 15000" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none font-bold text-gray-800">
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Keterangan / Catatan</label>
          <input type="text" id="tx-note" placeholder="Contoh: Beli Makan / Hasil Dagang" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm">
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeModal('modal-add')" class="px-4 py-2 text-sm font-semibold text-gray-500 hover:bg-gray-100 rounded-xl">Batal</button>
          <button type="submit" class="px-5 py-2 text-sm font-bold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow">Simpan</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL HUTANG / PIUTANG -->
  <div id="modal-debt" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-xl overflow-hidden">
      <div class="p-4 bg-indigo-600 text-white flex justify-between items-center">
        <h3 class="font-bold">Tambah Catatan Hutang / Piutang</h3>
        <button onclick="closeModal('modal-debt')" class="text-indigo-200 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>
      <form onsubmit="saveDebt(event)" class="p-5 space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Jenis Catatan</label>
          <div class="grid grid-cols-2 gap-2">
            <label class="flex items-center justify-center gap-2 p-2.5 border border-gray-200 rounded-xl cursor-pointer has-[:checked]:bg-emerald-50 has-[:checked]:border-emerald-500 font-semibold text-sm">
              <input type="radio" name="debt-type" value="piutang" checked class="accent-emerald-600">
              <span class="text-emerald-700">Piutang (Dia Utang)</span>
            </label>
            <label class="flex items-center justify-center gap-2 p-2.5 border border-gray-200 rounded-xl cursor-pointer has-[:checked]:bg-rose-50 has-[:checked]:border-rose-500 font-semibold text-sm">
              <input type="radio" name="debt-type" value="hutang" class="accent-rose-600">
              <span class="text-rose-700">Hutang (Saya Utang)</span>
            </label>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Nama Orang</label>
          <input type="text" id="debt-person" required placeholder="Contoh: Ikbal" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm">
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Nominal (Rp)</label>
          <input type="number" id="debt-amount" required min="1" placeholder="Contoh: 3000" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none font-bold text-gray-800">
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Keterangan</label>
          <input type="text" id="debt-note" placeholder="Contoh: Lupa bayar dimsum" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm">
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeModal('modal-debt')" class="px-4 py-2 text-sm font-semibold text-gray-500 hover:bg-gray-100 rounded-xl">Batal</button>
          <button type="submit" class="px-5 py-2 text-sm font-bold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow">Simpan</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL CATATAN RINGKAS -->
  <div id="modal-note" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-xl overflow-hidden">
      <div class="p-4 bg-indigo-600 text-white flex justify-between items-center">
        <h3 class="font-bold">Tambah / Edit Catatan</h3>
        <button onclick="closeModal('modal-note')" class="text-indigo-200 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>
      <form onsubmit="saveNote(event)" class="p-5 space-y-4">
        <input type="hidden" id="note-id">
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Judul Catatan</label>
          <input type="text" id="note-title" required placeholder="Judul..." class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none font-bold text-gray-800">
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Isi Catatan</label>
          <textarea id="note-content" rows="4" required placeholder="Tuliskan catatan Anda di sini..." class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeModal('modal-note')" class="px-4 py-2 text-sm font-semibold text-gray-500 hover:bg-gray-100 rounded-xl">Batal</button>
          <button type="submit" class="px-5 py-2 text-sm font-bold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow">Simpan Catatan</button>
        </div>
      </form>
    </div>
  </div>

  <!-- SCRIPT UTAMA APLIKASI -->
  <
